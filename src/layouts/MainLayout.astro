---
import '../styles/custom.css';
import '../../node_modules/@astrojs/starlight/style/layers.css';
import '../../node_modules/@astrojs/starlight/style/props.css';
import '../../node_modules/@astrojs/starlight/style/reset.css';
import '../../node_modules/@astrojs/starlight/style/asides.css';
import '../../node_modules/@astrojs/starlight/style/util.css';
import '@astrojs/starlight/style/markdown.css';
import printHref from '../../node_modules/@astrojs/starlight/style/print.css?url&no-inline';
import { siteConfig } from '../config/site';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { title, description = siteConfig.description, lang = siteConfig.lang } = Astro.props;

const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const { nav: navItems, seo, favicon } = siteConfig;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
---

<!DOCTYPE html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={seo.author} />
    <meta name="keywords" content={seo.keywords.join(', ')} />
    <meta name="robots" content={seo.robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={favicon.image} />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="stylesheet" href={printHref} media="print" />
    <style>
      html { scroll-padding-top: calc(1.5rem + var(--sl-nav-height)); }
      main { padding: var(--sl-main-pad); }
      :root {
        --sl-nav-height: 3.5rem;
        --sl-main-pad: 2rem 1.25rem 4rem;
        --sl-content-width: 67.5rem;
        --sl-hint-color: var(--sl-color-gray-3);
      }
      .site-header {
        position: sticky; top: 0; z-index: 50;
        background: var(--sl-color-bg-nav);
        border-bottom: 1px solid var(--sl-color-gray-5);
        backdrop-filter: saturate(180%) blur(10px);
      }
      .site-header-inner {
        max-width: var(--sl-content-width);
        margin: 0 auto;
        padding: 0 1.25rem;
        height: var(--sl-nav-height);
        display: flex; align-items: center; gap: 1.5rem;
      }
      .site-title {
        font-weight: 700; font-size: 1.05rem;
        color: var(--sl-color-text);
        text-decoration: none;
      }
      .site-nav { display: flex; gap: .25rem; align-items: center; }
      .site-nav a {
        padding: .4rem .75rem;
        border-radius: 6px;
        font-size: .9rem;
        color: var(--sl-color-gray-2);
        text-decoration: none;
        transition: background .15s, color .15s;
      }
      .site-nav a:hover { background: var(--sl-color-gray-6); color: var(--sl-color-text); }
      .site-nav a.active {
        background: var(--sl-color-bg-accent);
        color: var(--sl-color-white);
      }
      .site-main {
        max-width: var(--sl-content-width);
        margin: 0 auto;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <Logo />
        <nav class="site-nav">
          {navItems.map((item) => {
            const isActive = currentPath === item.href
              || (item.href !== '/' && currentPath.startsWith(item.href));
            return <a href={item.href} class={isActive ? 'active' : ''}>{item.label}</a>;
          })}
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
  </body>
</html>
