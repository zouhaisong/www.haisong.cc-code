---
import siteConfig from '~/config/site';
import Logo from '~/components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title: pageTitle,
  description: pageDescription,
} = Astro.props;

const fullTitle = pageTitle
  ? `${pageTitle} | ${siteConfig.title}`
  : siteConfig.title;
const description = pageDescription ?? siteConfig.description;
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang={siteConfig.locale.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={siteConfig.seo.keywords?.join(', ')} />

    <link rel="icon" type="image/svg+xml" href={siteConfig.favicon} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.seo.siteName ?? siteConfig.title} />
    {siteConfig.seo.defaultOGImage && (
      <meta property="og:image" content={siteConfig.seo.defaultOGImage} />
    )}

    <meta name="twitter:card" content={siteConfig.seo.twitter?.card ?? 'summary_large_image'} />
    {siteConfig.seo.twitter?.creator && (
      <meta name="twitter:creator" content={siteConfig.seo.twitter.creator} />
    )}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {siteConfig.seo.defaultTwitterImage && (
      <meta name="twitter:image" content={siteConfig.seo.defaultTwitterImage} />
    )}
  </head>
  <body class="layout">
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="site-brand" aria-label={siteConfig.title}>
          <Logo />
        </a>
        <nav class="site-nav" aria-label="主导航">
          <ul>
            {siteConfig.navigation.header.map((item) => (
              <li>
                <a href={item.link}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>© {currentYear} {siteConfig.title}. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .layout {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .site-header {
    border-bottom: 1px solid var(--sl-color-gray-6, #e5e7eb);
    background: var(--sl-color-bg, #ffffff);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .site-header-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .site-nav ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    text-decoration: none;
    color: var(--sl-color-text, #1f2937);
    font-weight: 500;
  }

  .site-nav a:hover {
    color: var(--sl-color-accent, #2563eb);
  }

  .site-main {
    flex: 1;
    max-width: 72rem;
    width: 100%;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    box-sizing: border-box;
  }

  .site-footer {
    border-top: 1px solid var(--sl-color-gray-6, #e5e7eb);
    background: var(--sl-color-bg, #ffffff);
  }

  .site-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem;
    color: var(--sl-color-text-accent, #6b7280);
    font-size: 0.875rem;
  }

  .site-footer-inner p {
    margin: 0;
  }
</style>
