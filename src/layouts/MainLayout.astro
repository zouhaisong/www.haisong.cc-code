---
import siteConfig from '~/config/site';
import Logo from '~/components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title: pageTitle,
  description: pageDescription,
} = Astro.props;

const fullTitle = pageTitle
  ? `${pageTitle} | ${siteConfig.title}`
  : siteConfig.title;
const description = pageDescription ?? siteConfig.description;
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang={siteConfig.locale.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={siteConfig.seo.keywords?.join(', ')} />

    <link rel="icon" type="image/svg+xml" href={siteConfig.favicon} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.seo.siteName ?? siteConfig.title} />
    {siteConfig.seo.defaultOGImage && (
      <meta property="og:image" content={siteConfig.seo.defaultOGImage} />
    )}

    <meta name="twitter:card" content={siteConfig.seo.twitter?.card ?? 'summary_large_image'} />
    {siteConfig.seo.twitter?.creator && (
      <meta name="twitter:creator" content={siteConfig.seo.twitter.creator} />
    )}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {siteConfig.seo.defaultTwitterImage && (
      <meta name="twitter:image" content={siteConfig.seo.defaultTwitterImage} />
    )}

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>

    <style is:global>
      :root {
        --hs-color-bg: #ffffff;
        --hs-color-text: #111827;
        --hs-color-text-accent: #6b7280;
        --hs-color-gray-5: #d1d5db;
        --hs-color-gray-6: #e5e7eb;
        --hs-color-gray-7: #f3f4f6;
        --hs-color-accent: #2563eb;
        --hs-color-accent-high: #1d4ed8;
        --hs-color-accent-low: rgba(37, 99, 235, 0.25);

        --sl-color-bg: var(--hs-color-bg);
        --sl-color-text: var(--hs-color-text);
        --sl-color-text-accent: var(--hs-color-text-accent);
        --sl-color-gray-5: var(--hs-color-gray-5);
        --sl-color-gray-6: var(--hs-color-gray-6);
        --sl-color-gray-7: var(--hs-color-gray-7);
        --sl-color-accent: var(--hs-color-accent);
        --sl-color-accent-high: var(--hs-color-accent-high);
        --sl-color-accent-low: var(--hs-color-accent-low);

        color-scheme: light;
      }

      [data-theme='dark'] {
        --hs-color-bg: #0f172a;
        --hs-color-text: #e5e7eb;
        --hs-color-text-accent: #94a3b8;
        --hs-color-gray-5: #334155;
        --hs-color-gray-6: #1e293b;
        --hs-color-gray-7: #1e293b;
        --hs-color-accent: #60a5fa;
        --hs-color-accent-high: #3b82f6;
        --hs-color-accent-low: rgba(96, 165, 250, 0.25);

        --sl-color-bg: var(--hs-color-bg);
        --sl-color-text: var(--hs-color-text);
        --sl-color-text-accent: var(--hs-color-text-accent);
        --sl-color-gray-5: var(--hs-color-gray-5);
        --sl-color-gray-6: var(--hs-color-gray-6);
        --sl-color-gray-7: var(--hs-color-gray-7);
        --sl-color-accent: var(--hs-color-accent);
        --sl-color-accent-high: var(--hs-color-accent-high);
        --sl-color-accent-low: var(--hs-color-accent-low);

        color-scheme: dark;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      :where(h2, h3, h4, h5, h6) { scroll-margin-top: 5rem; }
      body {
        background-color: var(--hs-color-bg);
        color: var(--hs-color-text);
        transition: background-color 0.2s ease, color 0.2s ease;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
          "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        line-height: 1.6;
      }
      a { color: inherit; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="site-brand" aria-label={siteConfig.title}>
          <Logo />
        </a>
        <div class="site-header-right">
          <nav class="site-nav" aria-label="主导航">
            <ul>
              {siteConfig.navigation.header.map((item) => (
                <li>
                  <a href={item.link}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="切换主题"
            title="切换主题"
          >
            <svg
              class="theme-icon theme-icon-sun"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <svg
              class="theme-icon theme-icon-moon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>© {currentYear} {siteConfig.title}. All rights reserved.</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        function bind() {
          var btn = document.getElementById('theme-toggle');
          if (!btn) return false;
          if (btn.__themeBound) return true;
          btn.__themeBound = true;
          btn.addEventListener('click', function () {
            var html = document.documentElement;
            var current = html.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
            var next = current === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            try { localStorage.setItem('theme', next); } catch (e) {}
          });
          return true;
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function once() {
            bind();
            document.removeEventListener('DOMContentLoaded', once);
          });
        } else {
          bind();
        }
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--hs-color-gray-6);
    background: color-mix(in srgb, var(--hs-color-bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .site-header-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .site-header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-nav ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    text-decoration: none;
    color: var(--hs-color-text);
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .site-nav a:hover {
    color: var(--hs-color-accent);
  }

  .theme-toggle {
    width: 2.25rem;
    height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    border: 1px solid var(--hs-color-gray-5);
    background: var(--hs-color-bg);
    color: var(--hs-color-text);
    cursor: pointer;
    padding: 0;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease, transform 0.1s ease;
  }

  .theme-toggle:hover {
    border-color: var(--hs-color-accent);
    color: var(--hs-color-accent);
  }

  .theme-toggle:active {
    transform: scale(0.96);
  }

  .theme-icon {
    width: 1.125rem;
    height: 1.125rem;
    stroke-width: 2;
  }

  .theme-icon-moon { display: none; }
  :global([data-theme='dark']) .theme-icon-sun { display: none; }
  :global([data-theme='dark']) .theme-icon-moon { display: block; }

  @media (max-width: 640px) {
    .site-nav { display: none; }
  }

  .site-main {
    min-height: 1px;
    max-width: 96rem;
    width: 100%;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .site-footer {
    border-top: 1px solid var(--hs-color-gray-6);
    background: var(--hs-color-bg);
  }

  .site-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem;
    color: var(--hs-color-text-accent);
    font-size: 0.875rem;
  }

  .site-footer-inner p { margin: 0; }
</style>
