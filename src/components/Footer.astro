---
import Default from '@astrojs/starlight/components/Footer.astro';
import siteConfig from '~/config/site';
---

<Default>
  <slot />
</Default>

{siteConfig.footer?.icp && (
  <p class="sl-flex sl-justify-center sl-gap-3 sl-text-muted sl-text-xs sl-mt-2">
    <a
      href={siteConfig.footer.icpLink ?? 'https://beian.miit.gov.cn/'}
      target="_blank"
      rel="noopener noreferrer"
    >
      {siteConfig.footer.icp}
    </a>
  </p>
)}
