---
import siteConfig from '~/config/site';

interface Props {
  src?: string;
  alt?: string;
  width?: number;
  height?: number;
}

const {
  src: propsSrc,
  alt: propsAlt,
  width = 32,
  height = 32,
} = Astro.props;

const { logo, title, titleEn } = siteConfig;
const lightSrc = propsSrc ?? logo.src;
const darkSrc = propsSrc ?? logo.alternate ?? logo.src;
const altText = propsAlt ?? logo.text ?? title;
const hasImage = Boolean(lightSrc);
const hasDarkVariant = darkSrc !== lightSrc;
const fallbackText = logo.text ?? title;
const fallbackTextEn = logo.textEn ?? titleEn;
---

<span class="logo">
  {hasImage ? (
    <>
      <img
        src={lightSrc}
        alt={altText}
        width={width}
        height={height}
        class="logo-img logo-img-light"
        loading="eager"
        decoding="sync"
      />
      {hasDarkVariant && (
        <img
          src={darkSrc}
          alt={altText}
          width={width}
          height={height}
          class="logo-img logo-img-dark"
          loading="eager"
          decoding="sync"
        />
      )}
    </>
  ) : null}
  <span class="logo-text-block">
    {fallbackText && (
      <span class="logo-text">{fallbackText}</span>
    )}
    {fallbackTextEn && (
      <span class="logo-text-en">{fallbackTextEn}</span>
    )}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    line-height: 1.1;
    font-weight: 700;
    font-size: 1.125rem;
  }

  .logo-img {
    display: block;
    object-fit: contain;
  }

  .logo-img-dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .logo-img-light {
      display: none;
    }
    .logo-img-dark {
      display: block;
    }
  }

  :global([data-theme='light']) .logo-img-dark {
    display: none;
  }
  :global([data-theme='light']) .logo-img-light {
    display: block;
  }

  :global([data-theme='dark']) .logo-img-light {
    display: none;
  }
  :global([data-theme='dark']) .logo-img-dark {
    display: block;
  }

  .logo-text-block {
    display: inline-flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .logo-text {
    color: var(--sl-color-text, #111827);
    line-height: 1;
  }

  .logo-text-en {
    color: var(--sl-color-text-accent, #6b7280);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    line-height: 1;
  }
</style>
