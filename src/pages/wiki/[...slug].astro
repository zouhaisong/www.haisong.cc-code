---
import type { GetStaticPaths } from 'astro';
import { getEntry, type CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { getPublishedCollection, entryUrl, type ColKey } from '../../lib/notes.js';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getPublishedCollection('wiki');
  return entries
    .filter((entry) => entry.slug && entry.slug !== 'index')
    .map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
};

const { entry } = Astro.props as { entry: CollectionEntry<'wiki'> };
const { Content } = await entry.render();

type RelatedRef = { entry: CollectionEntry<ColKey>; col: ColKey } | null;

const related = (await Promise.all(
  (entry.data.seealso || []).map(async (ref: string): Promise<RelatedRef> => {
    const [path] = ref.split(':');
    const [col, ...rest] = path.split('/');
    const slug = rest.join('/');
    if (col !== 'blog' && col !== 'wiki') return null;
    try {
      const entryOrCollection = await getEntry(col as ColKey, slug);
      if (!entryOrCollection) return null;
      return { entry: entryOrCollection as CollectionEntry<ColKey>, col: col as ColKey };
    } catch {
      return null;
    }
  }),
)).filter((r): r is NonNullable<RelatedRef> => Boolean(r));
---

<MainLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <header style="padding: 1rem 0;border-bottom: 1px solid var(--sl-color-gray-5);margin-bottom: 1.5rem;">
      <h1 style="margin:0 0 .5rem;">{entry.data.title}</h1>
      <p style="margin:0;color:var(--sl-color-gray-3);font-size:.9rem;">
        {entry.data.date instanceof Date && (
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toISOString().slice(0, 10)}
          </time>
        )}
        {entry.data.tags?.length ? (
          <>
            {' '}·{' '}
            {entry.data.tags.map((t: string) => (
              <code style="margin-right:.3rem;">#{t}</code>
            ))}
          </>
        ) : null}
        {entry.data.author ? <> · {entry.data.author}</> : null}
      </p>
      {entry.data.summary ? <p style="margin:.6rem 0 0;color:var(--sl-color-gray-3);">{entry.data.summary}</p> : null}
    </header>
    <section>
      <Content />
    </section>
    {related.length ? (
      <footer style="margin-top:3rem;padding-top:1rem;border-top:1px solid var(--sl-color-gray-5);">
        <h2 style="font-size:1rem;margin:0 0 .75rem;">相关条目</h2>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.5rem;">
          {related.map((r) => (
            <li>
              <a
                href={entryUrl(r.col, r.entry)}
                style="text-decoration:none;color:inherit;display:block;padding:.5rem .75rem;border:1px solid var(--sl-color-gray-5);border-radius:6px;"
              >
                <strong>{r.entry.data.title}</strong>
                {r.entry.data.summary ? (
                  <div style="color:var(--sl-color-gray-3);font-size:.85rem;margin-top:.15rem;">{r.entry.data.summary}</div>
                ) : null}
              </a>
            </li>
          ))}
        </ul>
      </footer>
    ) : null}
  </article>
</MainLayout>
