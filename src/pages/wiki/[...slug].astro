---
import MainLayout from '~/layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const entries = await getCollection('wiki', ({ data }) => !data.draft);
  return Promise.all(
    entries.map(async (entry) => {
      const slug = entry.id.replace(/\.md$/, '');
      const { Content } = await render(entry);
      return {
        params: { slug },
        props: { entry, Content },
      };
    }),
  );
}) satisfies GetStaticPaths;

type WikiEntry = Awaited<ReturnType<typeof getCollection<'wiki'>>>[number];
type RenderedContent = Awaited<ReturnType<typeof render>>;

interface Props {
  entry: WikiEntry;
  Content: RenderedContent['Content'];
}

const { entry, Content } = Astro.props;
const { data } = entry;
---

<MainLayout title={data.title} description={data.description}>
  <article class="wiki-entry">
    <header class="entry-head">
      <h1>{data.title}</h1>
      <div class="entry-meta">
        {data.updatedDate && (
          <time datetime={data.updatedDate.toISOString()}>
            更新于 {data.updatedDate.toLocaleDateString('zh-CN')}
          </time>
        )}
        {data.tags?.length > 0 && (
          <ul class="tag-list">
            {data.tags.map((t) => (
              <li class="tag">#{t}</li>
            ))}
          </ul>
        )}
      </div>
      {data.description && <p class="entry-desc">{data.description}</p>}
    </header>
    <div class="entry-content">
      <Content />
    </div>
  </article>
</MainLayout>

<style>
  .wiki-entry {
    max-width: 52rem;
    margin: 0 auto;
  }
  .entry-head {
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--sl-color-gray-6, #e5e7eb);
  }
  .entry-head h1 {
    margin: 0 0 1rem 0;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.25;
    color: var(--sl-color-text, #111827);
  }
  .entry-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    color: var(--sl-color-text-accent, #6b7280);
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }
  .tag-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.1875rem 0.5625rem;
    border-radius: 9999px;
    color: var(--sl-color-accent, #2563eb);
    background: color-mix(in srgb, var(--sl-color-accent, #2563eb) 10%, transparent);
  }
  .entry-desc {
    margin: 0;
    color: var(--sl-color-text-accent, #6b7280);
    line-height: 1.7;
    font-size: 1rem;
  }
  .entry-content {
    line-height: 1.8;
    color: var(--sl-color-text, #111827);
  }
  .entry-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }
  .entry-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }
  .entry-content :global(p) {
    margin: 1rem 0;
  }
  .entry-content :global(ul),
  .entry-content :global(ol) {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }
  .entry-content :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.75rem 1rem;
    border-left: 4px solid var(--sl-color-accent, #2563eb);
    background: color-mix(in srgb, var(--sl-color-accent, #2563eb) 6%, transparent);
    color: var(--sl-color-text, #374151);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .entry-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1rem 0;
  }
  .entry-content :global(a) {
    color: var(--sl-color-accent, #2563eb);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .entry-content :global(code) {
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
    border-radius: 0.375rem;
    background: var(--sl-color-gray-7, #f3f4f6);
  }
  .entry-content :global(pre) {
    padding: 1rem 1.25rem;
    border-radius: 0.625rem;
    overflow-x: auto;
    background: var(--sl-color-gray-7, #f3f4f6);
    margin: 1.25rem 0;
  }
  .entry-content :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .entry-content :global(.table-wrapper) {
    overflow-x: auto;
    margin: 1.25rem 0;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-6, #e5e7eb);
  }
  .entry-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    min-width: 100%;
  }
  .entry-content :global(thead) {
    background: var(--sl-color-gray-7, #f3f4f6);
  }
  .entry-content :global(th) {
    text-align: left;
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: var(--sl-color-text, #111827);
    border-bottom: 2px solid var(--sl-color-gray-6, #e5e7eb);
    white-space: nowrap;
  }
  .entry-content :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--sl-color-gray-6, #e5e7eb);
    color: var(--sl-color-text, #374151);
    vertical-align: top;
  }
  .entry-content :global(tbody tr:last-child td) {
    border-bottom: none;
  }
  .entry-content :global(tbody tr:nth-child(even)) {
    background: color-mix(in srgb, var(--sl-color-gray-7, #f3f4f6) 50%, transparent);
  }
  .entry-content :global(tbody tr:hover) {
    background: color-mix(in srgb, var(--sl-color-accent, #2563eb) 4%, transparent);
  }
  .entry-content :global(.callout) {
    margin: 1.25rem 0;
    border-radius: 0.5rem;
    border-left: 4px solid var(--callout-color, var(--sl-color-accent, #2563eb));
    background: color-mix(in srgb, var(--callout-color, var(--sl-color-accent, #2563eb)) 8%, transparent);
    overflow: hidden;
    --callout-color: var(--sl-color-accent, #2563eb);
  }
  .entry-content :global(.callout-note),
  .entry-content :global(.callout-info) {
    --callout-color: #3b82f6;
  }
  .entry-content :global(.callout-tip),
  .entry-content :global(.callout-hint),
  .entry-content :global(.callout-success),
  .entry-content :global(.callout-check),
  .entry-content :global(.callout-done) {
    --callout-color: #10b981;
  }
  .entry-content :global(.callout-important) {
    --callout-color: #8b5cf6;
  }
  .entry-content :global(.callout-question),
  .entry-content :global(.callout-help),
  .entry-content :global(.callout-faq) {
    --callout-color: #f59e0b;
  }
  .entry-content :global(.callout-warning),
  .entry-content :global(.callout-caution),
  .entry-content :global(.callout-attention) {
    --callout-color: #f59e0b;
  }
  .entry-content :global(.callout-failure),
  .entry-content :global(.callout-fail),
  .entry-content :global(.callout-missing),
  .entry-content :global(.callout-danger),
  .entry-content :global(.callout-error),
  .entry-content :global(.callout-bug) {
    --callout-color: #ef4444;
  }
  .entry-content :global(.callout-example) {
    --callout-color: #8b5cf6;
  }
  .entry-content :global(.callout-quote),
  .entry-content :global(.callout-cite) {
    --callout-color: #6b7280;
  }
  .entry-content :global(.callout-abstract),
  .entry-content :global(.callout-summary),
  .entry-content :global(.callout-tldr) {
    --callout-color: #06b6d4;
  }
  .entry-content :global(.callout-todo) {
    --callout-color: #0ea5e9;
  }
  .entry-content :global(.callout-title) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: var(--callout-color, var(--sl-color-text, #111827));
    background: color-mix(in srgb, var(--callout-color, var(--sl-color-accent, #2563eb)) 15%, transparent);
  }
  .entry-content :global(.callout-icon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    font-size: 0.9rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .entry-content :global(.callout-body) {
    padding: 0.75rem 1rem;
    color: var(--sl-color-text, #111827);
  }
  .entry-content :global(.callout-body > *:first-child) {
    margin-top: 0;
  }
  .entry-content :global(.callout-body > *:last-child) {
    margin-bottom: 0;
  }
  .entry-content :global(.callout-collapsible) {
    padding: 0;
  }
  .entry-content :global(.callout-collapsible .callout-summary) {
    list-style: none;
    cursor: pointer;
    padding: 0;
  }
  .entry-content :global(.callout-collapsible .callout-summary::-webkit-details-marker) {
    display: none;
  }
  .entry-content :global(.callout-collapsible .callout-summary::after) {
    content: '▾';
    margin-left: auto;
    font-size: 0.75rem;
    transition: transform 0.15s ease;
  }
  .entry-content :global(.callout-collapsible:not([open]) .callout-summary::after) {
    transform: rotate(-90deg);
  }
  .entry-content :global(.callout-collapsible[open] .callout-body) {
    border-top: 1px solid color-mix(in srgb, var(--callout-color, var(--sl-color-accent, #2563eb)) 20%, transparent);
  }
</style>
