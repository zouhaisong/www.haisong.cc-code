---
import { getCollection, type CollectionEntry } from 'astro:content';
import { slugify, filterPublish } from '../../lib/notes.js';
import MainLayout from '../../layouts/MainLayout.astro';

type AnyEntry = CollectionEntry<'blog'>;

const entries = (await getCollection('blog', filterPublish as any)) as AnyEntry[];
entries.sort((a, b) => {
  const da = a.data.date ? new Date(a.data.date).getTime() : 0;
  const db = b.data.date ? new Date(b.data.date).getTime() : 0;
  return db - da;
});

function linkFor(entry: AnyEntry) {
  const s = slugify(entry.id);
  return `/blog/${s}/`;
}
---

<MainLayout title="博客">
  <article>
    <header style="padding: 1rem 0;border-bottom: 1px solid var(--sl-color-gray-5);margin-bottom: 1.5rem;">
      <h1 style="margin:0 0 .5rem;">博客</h1>
      <p style="margin:0;color:var(--sl-color-gray-3);font-size:.95rem;">
        文章 · 每日笔记
      </p>
    </header>

    <section>
      {entries.length ? (
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.75rem;">
          {entries.map((e) => (
            <li>
              <a href={linkFor(e)} style="text-decoration:none;color:inherit;display:block;padding:.75rem 1rem;border:1px solid var(--sl-color-gray-5);border-radius:6px;">
                <div style="display:flex;align-items:baseline;gap:.75rem;margin-bottom:.25rem;">
                  <strong>{e.data.title}</strong>
                  {e.data.date ? (
                    <time style="font-size:.8rem;color:var(--sl-color-gray-3);">
                      {new Date(e.data.date).toISOString().slice(0, 10)}
                    </time>
                  ) : null}
                </div>
                {e.data.summary ? <p style="margin:0;color:var(--sl-color-gray-3);font-size:.9rem;">{e.data.summary}</p> : null}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p style="color:var(--sl-color-gray-3);">暂无文章。</p>
      )}
    </section>
  </article>
</MainLayout>
