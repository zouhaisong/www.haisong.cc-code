---
import MainLayout from '~/layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return Promise.all(
    posts.map(async (post) => {
      const slug = post.id.replace(/\.md$/, '');
      const { Content } = await render(post);
      return {
        params: { slug },
        props: { post, Content },
      };
    }),
  );
}) satisfies GetStaticPaths;

type BlogEntry = Awaited<ReturnType<typeof getCollection<'blog'>>>[number];
type RenderedContent = Awaited<ReturnType<typeof render>>;

interface Props {
  post: BlogEntry;
  Content: RenderedContent['Content'];
}

const { post, Content } = Astro.props;
const { data } = post;
---

<MainLayout title={data.title} description={data.description}>
  <article class="post">
    <header class="post-head">
      <h1>{data.title}</h1>
      <div class="post-meta">
        <time datetime={data.pubDate.toISOString()}>
          {data.pubDate.toLocaleDateString('zh-CN')}
        </time>
        {data.author && <span class="post-author">作者：{data.author}</span>}
        {data.tags?.length > 0 && (
          <ul class="tag-list">
            {data.tags.map((t) => (
              <li class="tag">#{t}</li>
            ))}
          </ul>
        )}
      </div>
      {data.description && <p class="post-desc">{data.description}</p>}
    </header>
    <div class="post-content">
      <Content />
    </div>
  </article>
</MainLayout>

<style>
  .post {
    max-width: 48rem;
    margin: 0 auto;
  }
  .post-head {
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--sl-color-gray-6, #e5e7eb);
  }
  .post-head h1 {
    margin: 0 0 1rem 0;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.25;
    color: var(--sl-color-text, #111827);
  }
  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    color: var(--sl-color-text-accent, #6b7280);
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }
  .post-author::before {
    content: '·';
    margin-right: 1rem;
    color: var(--sl-color-gray-5, #d1d5db);
  }
  .tag-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.1875rem 0.5625rem;
    border-radius: 9999px;
    color: var(--sl-color-accent, #2563eb);
    background: color-mix(in srgb, var(--sl-color-accent, #2563eb) 10%, transparent);
  }
  .post-desc {
    margin: 0;
    color: var(--sl-color-text-accent, #6b7280);
    line-height: 1.7;
    font-size: 1rem;
  }
  .post-content {
    line-height: 1.8;
    color: var(--sl-color-text, #111827);
  }
  .post-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }
  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }
  .post-content :global(p) {
    margin: 1rem 0;
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }
  .post-content :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.75rem 1rem;
    border-left: 4px solid var(--sl-color-accent, #2563eb);
    background: color-mix(in srgb, var(--sl-color-accent, #2563eb) 6%, transparent);
    color: var(--sl-color-text, #374151);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1rem 0;
  }
  .post-content :global(a) {
    color: var(--sl-color-accent, #2563eb);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .post-content :global(code) {
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
    border-radius: 0.375rem;
    background: var(--sl-color-gray-7, #f3f4f6);
  }
  .post-content :global(pre) {
    padding: 1rem 1.25rem;
    border-radius: 0.625rem;
    overflow-x: auto;
    background: var(--sl-color-gray-7, #f3f4f6);
    margin: 1.25rem 0;
  }
  .post-content :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .post-content :global(.table-wrapper) {
    overflow-x: auto;
    margin: 1.25rem 0;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-6, #e5e7eb);
  }
  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    min-width: 100%;
  }
  .post-content :global(thead) {
    background: var(--sl-color-gray-7, #f3f4f6);
  }
  .post-content :global(th) {
    text-align: left;
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: var(--sl-color-text, #111827);
    border-bottom: 2px solid var(--sl-color-gray-6, #e5e7eb);
    white-space: nowrap;
  }
  .post-content :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--sl-color-gray-6, #e5e7eb);
    color: var(--sl-color-text, #374151);
    vertical-align: top;
  }
  .post-content :global(tbody tr:last-child td) {
    border-bottom: none;
  }
  .post-content :global(tbody tr:nth-child(even)) {
    background: color-mix(in srgb, var(--sl-color-gray-7, #f3f4f6) 50%, transparent);
  }
  .post-content :global(tbody tr:hover) {
    background: color-mix(in srgb, var(--sl-color-accent, #2563eb) 4%, transparent);
  }
</style>
