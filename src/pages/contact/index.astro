---
import MainLayout from '~/layouts/MainLayout.astro';
import siteConfig from '~/config/site';
---

<MainLayout title={siteConfig.contact.title} description={siteConfig.contact.lead}>
  <section class="page-section contact-page">
    <header class="page-head">
      <div>
        <h1 class="page-title">{siteConfig.contact.title}</h1>
        {siteConfig.contact.titleEn && (
          <p class="page-subtitle-en">{siteConfig.contact.titleEn}</p>
        )}
      </div>
      {siteConfig.contact.lead && <p class="page-lead">{siteConfig.contact.lead}</p>}
    </header>

    <div class="contact-list">
      {siteConfig.contact.channels.map((channel) => {
        const Tag = channel.link ? 'a' : 'div';
        return (
          <Tag
            class={['contact-item', channel.link ? 'contact-item-link' : ''].filter(Boolean).join(' ')}
            {...(channel.link ? { href: channel.link } : {})}
          >
            {channel.icon && <span class={`contact-icon contact-icon-${channel.icon}`} aria-hidden="true" />}
            <div class="contact-main">
              <span class="contact-label">{channel.label}</span>
              <span class="contact-value">{channel.value}</span>
            </div>
          </Tag>
        );
      })}
    </div>
  </section>
</MainLayout>

<style>
  .page-section {
    padding: 1rem 0 2rem 0;
  }
  .page-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--sl-color-gray-6, #e5e7eb);
  }
  .page-title {
    margin: 0;
    font-size: 2rem;
    color: var(--sl-color-text, #111827);
  }
  .page-subtitle-en {
    margin: 0.375rem 0 0 0;
    color: var(--sl-color-text-accent, #6b7280);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .page-lead {
    margin: 0;
    max-width: 32rem;
    color: var(--sl-color-text-accent, #6b7280);
    line-height: 1.7;
  }

  .contact-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--sl-color-gray-6, #e5e7eb);
    border-radius: 0.75rem;
    background: var(--sl-color-bg, #ffffff);
    color: inherit;
  }
  .contact-item-link {
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .contact-item-link:hover {
    border-color: var(--sl-color-accent, #2563eb);
    transform: translateY(-2px);
  }
  .contact-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.625rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--sl-color-accent, #2563eb) 10%, transparent);
    color: var(--sl-color-accent, #2563eb);
    font-weight: 700;
    flex-shrink: 0;
  }
  .contact-icon-email::before {
    content: '@';
  }
  .contact-icon-link::before {
    content: '↗';
  }
  .contact-main {
    display: inline-flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }
  .contact-label {
    font-size: 0.8125rem;
    color: var(--sl-color-text-accent, #6b7280);
    font-weight: 500;
  }
  .contact-value {
    color: var(--sl-color-text, #111827);
    font-weight: 600;
    font-size: 1rem;
    word-break: break-all;
  }
</style>
