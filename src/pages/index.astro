---
import MainLayout from '~/layouts/MainLayout.astro';
import siteConfig from '~/config/site';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
.slice(0, 3);

const wikiEntries = (await getCollection('wiki', ({ data }) => !data.draft))
.sort((a, b) => a.data.order - b.data.order)
.slice(0, 4);
---

<MainLayout>
  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-title">{siteConfig.title}</h1>
      <p class="hero-subtitle">{siteConfig.description}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/blog/">进入文章</a>
        <a class="btn btn-secondary" href="/wiki/">浏览知识库</a>
      </div>
    </div>
  </section>

  <section class="overview">
    <div class="cards">
      <a class="card" href="/blog/">
        <div class="card-head">
          <h2>文章</h2>
          <span class="card-meta">{recentPosts.length > 0 ? '最新文章' : '内容入口'}</span>
        </div>
        <p>记录编程智能体的实战经验、踩坑与方法论沉淀。</p>
        {recentPosts.length > 0 && (
          <ul class="mini-list">
            {recentPosts.map((p) => (
              <li>
                <span class="dot" aria-hidden="true" />
                <span>{p.data.title}</span>
              </li>
            ))}
          </ul>
        )}
      </a>

      <a class="card" href="/wiki/">
        <div class="card-head">
          <h2>知识库</h2>
          <span class="card-meta">{wikiEntries.length > 0 ? '精选条目' : '知识库'}</span>
        </div>
        <p>体系化组织的知识点与操作手册，用于可复用框架的检索。</p>
        {wikiEntries.length > 0 && (
          <ul class="mini-list">
            {wikiEntries.map((w) => (
              <li>
                <span class="dot" aria-hidden="true" />
                <span>{w.data.title}</span>
              </li>
            ))}
          </ul>
        )}
      </a>
    </div>

  </section>
</MainLayout>

<style>
  .hero {
    padding: 2rem 0 3rem 0;
    text-align: center;
  }
  .hero-inner {
    max-width: 48rem;
    margin: 0 auto;
  }
  .hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0 0 1rem 0;
    color: var(--sl-color-text, #111827);
    letter-spacing: -0.01em;
  }
  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--sl-color-text-accent, #6b7280);
    margin: 0 0 2rem 0;
    line-height: 1.7;
  }
  .hero-cta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .btn-primary {
    background: var(--sl-color-accent, #2563eb);
    color: #ffffff;
  }
  .btn-primary:hover {
    background: var(--sl-color-accent-high, #1d4ed8);
  }
  .btn-secondary {
    background: var(--sl-color-gray-7, #f3f4f6);
    color: var(--sl-color-text, #111827);
    border: 1px solid var(--sl-color-gray-5, #d1d5db);
  }
  .btn-secondary:hover {
    background: var(--sl-color-gray-6, #e5e7eb);
  }

  .overview {
    padding: 2rem 0 1rem 0;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.25rem;
  }
  .card {
    display: block;
    padding: 1.75rem;
    border: 1px solid var(--sl-color-gray-6, #e5e7eb);
    border-radius: 0.875rem;
    background: var(--sl-color-bg, #ffffff);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover {
    border-color: var(--sl-color-accent, #2563eb);
    transform: translateY(-2px);
  }
  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .card-head h2 {
    margin: 0;
    font-size: 1.375rem;
    color: var(--sl-color-text, #111827);
  }
  .card-meta {
    font-size: 0.8125rem;
    color: var(--sl-color-text-accent, #6b7280);
  }
  .card > p {
    margin: 0 0 1rem 0;
    color: var(--sl-color-text-accent, #6b7280);
    line-height: 1.65;
  }
  .mini-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .mini-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--sl-color-text, #374151);
  }
  .dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--sl-color-accent, #2563eb);
    flex-shrink: 0;
  }
</style>
