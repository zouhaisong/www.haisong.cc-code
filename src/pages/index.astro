---
import { getCollection, type CollectionEntry } from 'astro:content';
import { slugify, filterPublish } from '../lib/notes.js';
import MainLayout from '../layouts/MainLayout.astro';
import { siteConfig } from '../config/site';

type AnyEntry = CollectionEntry<'blog' | 'wiki'>;

const blogEntries = (await getCollection('blog', filterPublish as any)) as AnyEntry[];
blogEntries.sort((a: AnyEntry, b: AnyEntry) => {
  const da = a.data.date ? new Date(a.data.date).getTime() : 0;
  const db = b.data.date ? new Date(b.data.date).getTime() : 0;
  return db - da;
});
const blogTop = blogEntries.slice(0, 5);

const wikiTop = ((await getCollection('wiki', filterPublish as any)) as AnyEntry[]).slice(0, 5);

function linkFor(collection: string, entry: AnyEntry) {
  const s = slugify(entry.id);
  return `/${collection}/${s}/`;
}
---

<MainLayout>
  <article>
    <header style="padding: 1rem 0;border-bottom: 1px solid var(--sl-color-gray-5);margin-bottom: 1.5rem;">
      <h1 style="margin:0 0 .5rem;">{siteConfig.tagline}</h1>
      <p style="margin:0;color:var(--sl-color-gray-3);font-size:.95rem;">
        文章 · 知识库 · 海松
      </p>
    </header>

    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size:1.25rem;margin:0 0 1rem;">最新文章</h2>
      {blogTop.length ? (
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.75rem;">
          {blogTop.map((e) => (
            <li>
              <a href={linkFor('blog', e)} style="text-decoration:none;color:inherit;display:block;padding:.75rem 1rem;border:1px solid var(--sl-color-gray-5);border-radius:6px;">
                <div style="display:flex;align-items:baseline;gap:.75rem;margin-bottom:.25rem;">
                  <strong>{e.data.title}</strong>
                  {e.data.date ? (
                    <time style="font-size:.8rem;color:var(--sl-color-gray-3);">
                      {new Date(e.data.date).toISOString().slice(0, 10)}
                    </time>
                  ) : null}
                </div>
                {e.data.summary ? <p style="margin:0;color:var(--sl-color-gray-3);font-size:.9rem;">{e.data.summary}</p> : null}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p style="color:var(--sl-color-gray-3);">暂无文章。</p>
      )}
      <p style="margin-top:1rem;">
        <a href="/blog/">全部文章 →</a>
      </p>
    </section>

    <section>
      <h2 style="font-size:1.25rem;margin:0 0 1rem;">知识库</h2>
      {wikiTop.length ? (
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.75rem;">
          {wikiTop.map((e) => (
            <li>
              <a href={linkFor('wiki', e)} style="text-decoration:none;color:inherit;display:block;padding:.75rem 1rem;border:1px solid var(--sl-color-gray-5);border-radius:6px;">
                <div style="margin-bottom:.25rem;">
                  <strong>{e.data.title}</strong>
                </div>
                {e.data.summary ? <p style="margin:0;color:var(--sl-color-gray-3);font-size:.9rem;">{e.data.summary}</p> : null}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p style="color:var(--sl-color-gray-3);">暂无条目。</p>
      )}
      <p style="margin-top:1rem;">
        <a href="/wiki/home/">全部知识库 →</a>
      </p>
    </section>
  </article>
</MainLayout>
