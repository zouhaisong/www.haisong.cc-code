---
import MainLayout from '~/layouts/MainLayout.astro';
import siteConfig from '~/config/site';
import { getCollection } from 'astro:content';

const docsEntries = await getCollection('docs', ({ data }) => !data.draft);

const recentPosts = docsEntries
  .filter((e) => e.id.startsWith('blog/') && typeof e.data?.date !== 'undefined')
  .sort((a, b) => (b.data.date as Date).getTime() - (a.data.date as Date).getTime())
  .slice(0, 3);

const wikiEntries = docsEntries
  .filter((e) => e.id.startsWith('wiki/'))
  .sort((a, b) => (a.data.sidebar?.order ?? 0) - (b.data.sidebar?.order ?? 0) || a.data.title.localeCompare(b.data.title, 'zh-CN'))
  .slice(0, 4);

const features = [
  {
    title: 'AI编程',
    description: 'AI编程方法论、工程实践总结。',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>`,
  },
  {
    title: 'AI应用',
    description: '智能问答、知识库、智能体、知识图谱、人工智能落地场景。',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>`,
  },
  {
    title: '软件工程',
    description: 'AI时代的软件工程, 软件生命周期、软件研发过程、领域驱动、自动化测试、持续集成、持续交付、DevOps、云原生。',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>`,
  },
  {
    title: '数字化转型落地',
    description: '用户旅程、事件风暴、领域划分、服务划分、产品探索、产品定义。',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
  },
];
---

<MainLayout>
  <section class="hero">
    <div class="hero-aurora" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        <span>Something Haisong know</span>
      </div>
      <h1 class="hero-title">
        <span class="hero-title-main">{siteConfig.title}</span>
        <span class="hero-title-grad">AI与软件工程的深度融合</span>
      </h1>
      <p class="hero-subtitle">{siteConfig.description}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/wiki/home/">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          进入知识库
        </a>
        <a class="btn btn-secondary" href="/blog/">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>
          浏览文章
        </a>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="features-inner">
      <div class="features-head">
        <h2 class="features-title">这是一个美好的时代</h2>
        <figure class="features-quote">
          <blockquote class="features-lead">
            <span>工厂在加班工作</span>
            <span>赶制一架飞机</span>
            <span>准备在夜里飞往月亮</span>
          </blockquote>
        </figure>
      </div>
      <div class="features-grid">
        {features.map((f) => (
          <div class="feature-card">
            <div class="feature-icon" set:html={f.icon} />
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="overview">
    <div class="cards">
      <a class="card" href="/blog/">
        <div class="card-head">
          <h2>文章</h2>
          <span class="card-meta">{recentPosts.length > 0 ? '最新文章' : '内容入口'}</span>
        </div>
        <p>记录编程智能体的实战经验、踩坑与方法论沉淀。</p>
        {recentPosts.length > 0 && (
          <ul class="mini-list">
            {recentPosts.map((p) => (
              <li>
                <span class="dot" aria-hidden="true" />
                <span>{p.data.title}</span>
              </li>
            ))}
          </ul>
        )}
      </a>

      <a class="card" href="/wiki/">
        <div class="card-head">
          <h2>知识库</h2>
          <span class="card-meta">{wikiEntries.length > 0 ? '精选条目' : '知识库'}</span>
        </div>
        <p>体系化组织的知识点与操作手册，用于可复用框架的检索。</p>
        {wikiEntries.length > 0 && (
          <ul class="mini-list">
            {wikiEntries.map((w) => (
              <li>
                <span class="dot" aria-hidden="true" />
                <span>{w.data.title}</span>
              </li>
            ))}
          </ul>
        )}
      </a>

      <a class="card card-works" href="/works/">
        <div class="card-head">
          <h2>作品</h2>
          <span class="card-meta">{siteConfig.works.items.length} 个项目</span>
        </div>
        <p>过往构建的站点、工具链与开源实践合集。</p>
        <div class="card-foot">
          <span class="card-more">前往作品展示 →</span>
        </div>
      </a>

      <a class="card card-contact" href="/contact/">
        <div class="card-head">
          <h2>联系</h2>
          <span class="card-meta">{siteConfig.contact.channels.length} 个渠道</span>
        </div>
        <p>关于编程智能体、知识沉淀或站点合作，欢迎建立联络。</p>
        <div class="card-foot">
          <span class="card-more">查看联系方式 →</span>
        </div>
      </a>
    </div>
  </section>
</MainLayout>

<style>
  .hero {
    position: relative;
    padding: 5rem 0 4.5rem 0;
    text-align: center;
    overflow: hidden;
  }

  .hero-aurora {
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 80rem;
    height: 40rem;
    background:
      radial-gradient(ellipse at 20% 30%, rgba(37, 99, 235, 0.18), transparent 50%),
      radial-gradient(ellipse at 80% 40%, rgba(168, 85, 247, 0.14), transparent 55%),
      radial-gradient(ellipse at 50% 80%, rgba(16, 185, 129, 0.12), transparent 50%);
    filter: blur(20px);
    pointer-events: none;
    z-index: 0;
  }

  [data-theme='dark'] .hero-aurora {
    background:
      radial-gradient(ellipse at 20% 30%, rgba(96, 165, 250, 0.22), transparent 50%),
      radial-gradient(ellipse at 80% 40%, rgba(192, 132, 252, 0.18), transparent 55%),
      radial-gradient(ellipse at 50% 80%, rgba(52, 211, 153, 0.14), transparent 50%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--hs-color-gray-6) 1px, transparent 1px),
      linear-gradient(90deg, var(--hs-color-gray-6) 1px, transparent 1px);
    background-size: 3rem 3rem;
    mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.6) 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.6) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  [data-theme='dark'] .hero-grid {
    background-image:
      linear-gradient(rgba(75, 85, 99, 0.25) 1px, transparent 1px),
      linear-gradient(90deg, rgba(75, 85, 99, 0.25) 1px, transparent 1px);
  }

  .hero-inner {
    position: relative;
    max-width: 56rem;
    margin: 0 auto;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.875rem;
    border-radius: 9999px;
    border: 1px solid var(--hs-color-gray-5);
    background: var(--hs-color-bg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--hs-color-text-accent);
    margin-bottom: 1.75rem;
  }

  .hero-badge-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, #22c55e, #16a34a);
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15);
  }

  .hero-title {
    margin: 0 0 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero-title-main {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 800;
    color: var(--hs-color-text);
  }

  .hero-title-grad {
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    font-weight: 700;
    background: linear-gradient(135deg, #2563eb 0%, #a855f7 50%, #ec4899 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--hs-color-text-accent);
    margin: 0 auto 2.25rem auto;
    max-width: 40rem;
    line-height: 1.75;
  }

  .hero-cta {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    border-radius: 0.625rem;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .btn svg {
    width: 1rem;
    height: 1rem;
  }

  .btn-primary {
    background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
    color: #ffffff;
    box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.35);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px 0 rgba(37, 99, 235, 0.45);
    background: linear-gradient(135deg, #1d4ed8 0%, #4338ca 100%);
  }

  .btn-secondary {
    background: var(--hs-color-bg);
    color: var(--hs-color-text);
    border: 1px solid var(--sl-color-gray-5, #d1d5db);
  }

  .btn-secondary:hover {
    transform: translateY(-1px);
    border-color: var(--hs-color-accent);
    color: var(--hs-color-accent);
  }

  .features {
    padding: 2rem 0 1rem 0;
  }

  .features-inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  .features-head {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .features-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 750;
    color: var(--hs-color-text);
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
  }

  .features-quote {
    margin: 0.75rem 0 0 0;
    padding: 0;
    display: flex;
    justify-content: center;
  }

  .features-lead {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
    padding: 1.25rem 2.25rem;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--hs-color-text-accent);
    font-style: italic;
    font-weight: 450;
    letter-spacing: 0.02em;
  }

  .features-lead::before,
  .features-lead::after {
    position: absolute;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 3.5rem;
    line-height: 1;
    color: var(--hs-color-accent-low, #c7d2fe);
    font-style: normal;
    font-weight: 700;
    opacity: 0.7;
  }

  .features-lead::before {
    content: "\201C";
    top: -0.25rem;
    left: 0;
  }

  .features-lead::after {
    content: "\201D";
    bottom: -1.25rem;
    right: 0.25rem;
  }

  [data-theme='dark'] .features-lead::before,
  [data-theme='dark'] .features-lead::after {
    color: rgba(96, 165, 250, 0.35);
  }

  .features-lead span {
    display: block;
    text-align: center;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }

  .feature-card {
    padding: 1.5rem;
    border-radius: 0.875rem;
    border: 1px solid var(--sl-color-gray-6, #e5e7eb);
    background: var(--hs-color-bg);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .feature-card:hover {
    border-color: var(--hs-color-accent-low));
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.08);
  }

  .feature-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.625rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(168, 85, 247, 0.1));
    color: var(--hs-color-accent);
  }

  [data-theme='dark'] .feature-icon {
    background: linear-gradient(135deg, rgba(96, 165, 250, 0.18), rgba(192, 132, 252, 0.15));
  }

  .feature-icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    stroke-width: 2;
  }

  .feature-title {
    font-size: 1.0625rem;
    font-weight: 650;
    margin: 0 0 0.375rem 0;
    color: var(--hs-color-text);
  }

  .feature-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--hs-color-text-accent);
    margin: 0;
  }

  .overview {
    padding: 3rem 0 1rem 0;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.25rem;
  }

  .card {
    display: block;
    padding: 1.75rem;
    border: 1px solid var(--sl-color-gray-6, #e5e7eb);
    border-radius: 0.875rem;
    background: var(--hs-color-bg);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    display: flex;
    flex-direction: column;
  }

  .card:hover {
    border-color: var(--hs-color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.08);
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .card-head h2 {
    margin: 0;
    font-size: 1.375rem;
    color: var(--hs-color-text);
  }

  .card-meta {
    font-size: 0.8125rem;
    color: var(--hs-color-text-accent);
  }

  .card > p {
    margin: 0 0 1rem 0;
    color: var(--hs-color-text-accent);
    line-height: 1.65;
    flex: 1;
  }

  .mini-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .mini-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--hs-color-text);
  }

  .dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--hs-color-accent);
    flex-shrink: 0;
  }

  .card-foot {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .card-more {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--hs-color-accent);
  }
</style>
